[
  # always use the forward declarations from the lib headers
  { "symbol": ["PPmap", "full", '"ppmap.h"', "public"] },
  { "symbol": ["IPmap", "full", '"ipmap.h"', "public"] },
  { "symbol": ["SPmap", "full", '"spmap.h"', "public"] },
  { "symbol": ["SImap", "full", '"simap.h"', "public"] },
