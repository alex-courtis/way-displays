# do not check generated code
*:pro

# compilation unit only functions are in .h for documentation purposes
staticFunction:yaml/marshal-types.c
staticFunction:yaml/unmarshal.c
staticFunction:yaml/unmarshal-types.c

# unused are implemented for completeness
unusedFunction:src/convert.c

# many library functions are not used
unusedFunction:lib/alex-c
staticFunction:lib/alex-c

# wraps are dynamically invoked at runtime only
unusedFunction:tst/wrap*.c

# this is just not practical
nullPointerOutOfMemory

# requires too much function pointer casting
constParameterCallback:listener/*c

# does not identify correctly
unusedStructMember
 
# not sure why this doesn't work; iwyu takes care of it
missingIncludeSystem

# this does not handle function pointer types
funcArgNamesDifferentUnnamed

# this is explicitly OK
varFuncNullUB
