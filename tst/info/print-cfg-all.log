  Arrange in a ROW aligned at the TOP
  Order:
    first
    last
  Scaling: ON
  Auto scale: ON (dpi: 96, min: 1.000)
  Round scales to: 0.5, DOWN
  Scale:
    three: 3.000
    four: 4.000
  Mode:
    five: 1920x1080@12.34Hz
    six: 2560x1440
    seven: MAX
    eight: MAX Preferred Refresh
  Transform:
    twelve: FLIPPED
  Disabled:
    !eDP-[0-9] (conditionally)
    disabled always
    disabled conditionally (conditionally)
  Callback command:
    notify-send "way-displays ${CALLBACK_LEVEL}" "${CALLBACK_MSG}"
